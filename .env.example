# Required only for live OpenAI-compatible model runs. Never commit a real key.
OPENAI_API_KEY=
# Optional. Use the full API root, normally ending in /v1.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional runtime overrides.
MINI_HARNESS_PROVIDER=openai
MINI_HARNESS_MODEL=gpt-5.6-terra
# auto prefers native function tools and falls back only if the gateway rejects them.
MINI_HARNESS_OPENAI_TOOL_MODE=auto
# Use codex only when the selected gateway requires the Codex Responses client contract.
MINI_HARNESS_OPENAI_CLIENT_PROFILE=standard
MINI_HARNESS_MAX_TURNS=12
MINI_HARNESS_FINALIZATION_TURN=true
MINI_HARNESS_TOOL_TIMEOUT_SECONDS=30
MINI_HARNESS_MAX_OUTPUT_CHARS=20000
MINI_HARNESS_WRITE_POLICY=ask
MINI_HARNESS_SHELL_POLICY=ask
